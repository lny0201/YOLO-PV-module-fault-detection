# --------------------------------------------------------------------------------------------------
# Minimal GitHub upload set for this project
# Default to ignoring everything, then explicitly allow only the files needed for:
# 1) running the project scripts
# 2) showing the README images
# --------------------------------------------------------------------------------------------------
*

# Root files
!/.gitignore
!/README.md
!/requirements.txt
!/pyproject.toml
!/LICENSE
!/app.py
!/detect.py

# Keep only the dataset config/scripts and the trained weights actually used by the project
!/datasets/
/datasets/*
!/datasets/data.yaml
!/datasets/train.py
!/datasets/test.py
!/datasets/data.py
!/datasets/model/
/datasets/model/*
!/datasets/model/YOLOv8/
!/datasets/model/YOLOv10/
!/datasets/model/YOLOv11/
/datasets/model/YOLOv8/*
/datasets/model/YOLOv10/*
/datasets/model/YOLOv11/*
!/datasets/model/YOLOv8/best.pt
!/datasets/model/YOLOv10/best.pt
!/datasets/model/YOLOv11/best.pt

# Keep only README images
!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/confusion_matrix.png
!/docs/images/training_results.png
!/docs/images/overview_train_batch0.jpg
!/docs/images/overview_train_batch1.jpg
!/docs/images/sample_input_1.jpg
!/docs/images/sample_input_2.jpg
!/docs/images/sample_pred_1.jpg
!/docs/images/sample_pred_2.jpg
